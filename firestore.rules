rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // User can read and write only their own user profile document
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Family Circle rules
    match /familyCircles/{circleId} {
      
      // Check if the current user is a member of this existing circle
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.memberIds;
      }
      
      // Check if the user is adding themselves as a member in the new data
      function isBecomingMember() {
        return isSignedIn() && request.auth.uid in request.resource.data.memberIds;
      }
      
      // CREATION and UPDATES are now strictly server-enforced via Cloud Functions.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
      
      // Subcollection: dailyLogs
      // Written by server, read by members
      match /dailyLogs/{logId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/familyCircles/$(circleId)).data.memberIds;
        allow write: if false; // Server-only
      }
      
      // Subcollection: tasks
      // Read and created by members. Updates/Deletes by Server.
      match /tasks/{taskId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/familyCircles/$(circleId)).data.memberIds;
        allow create: if isSignedIn() 
                      && request.auth.uid in get(/databases/$(database)/documents/familyCircles/$(circleId)).data.memberIds
                      && request.resource.data.status == "pending"
                      && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
    }
    
    // Invites collection: Strictly server-side
    match /invites/{inviteId} {
      allow read, write: if false;
    }
  }
}
