rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper to check if user is a member of the given circle
    // Note: Storage Rules cannot easily read Firestore without specific configuration
    // (firestore.get) and it requires matching rule locations.
    // Assuming the path is audio_inbox/{circleId}/{userId}/{fileId}, we can enforce 
    // that the userId matches request.auth.uid, and rely on Cloud Functions to 
    // validate the circleId upon processing.
    
    match /audio_inbox/{circleId}/{userId}/{fileId} {
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('audio/.*')
                   && request.auth.uid in firestore.get(/databases/(default)/documents/familyCircles/$(circleId)).data.memberIds;
      
      allow read: if false;
    }
  }
}
